     <ELEM name="maxTransfers" type="num" maxsize="7" minnum="0" />
     <ELEM name="singleBookingAllowed" type="alpha" maxsize="1" minnum="0" />
     <ELEM name="purposeCodes" type="ascii" maxsize="4096" minnum="0" />
