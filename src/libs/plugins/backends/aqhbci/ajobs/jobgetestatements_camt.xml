   <GROUP type="SegHead" name="head" />
   <GROUP type="kti_i" version="1" />
   <ELEM  name="maxEntries" type="num"   maxsize="4"  minnum="0" />
   <ELEM  name="attach"     type="ascii" maxsize="35" minnum="0" />

