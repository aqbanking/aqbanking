   <ELEM  name="num"          type="num"   maxsize="5"  minnum="0" />
   <ELEM  name="ack"          type="an"    maxsize="4"  minnum="0" />
   <ELEM  name="downloadable" type="alpha" maxsize="1"  minnum="0" />
   <ELEM  name="year"         type="num"   maxsize="4"  minnum="0" />
   <ELEM  name="date"         type="date"  minsize="8"  maxsize="8" minnum="0" />
   <ELEM  name="time"         type="time"  minsize="6"  maxsize="6" minnum="0" />
   <ELEM  name="createType"   type="ascii" maxsize="35" minnum="0" />

