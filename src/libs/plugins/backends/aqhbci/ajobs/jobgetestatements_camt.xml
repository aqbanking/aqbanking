</SEGs>


<JOBs>

 <!-- Geschaeftsvorfall: Kontoauszug camt (Version 1) -->
 <JOBdef id="JobGetEStatementsCAMT"
         code="HKECA"
         params="HIECAS"
         version="1"
         crypt="1"
         sign="1"
         needBPD="1"
         response="EStatementCAMT"
         attachable="1"
         single="1"
 >
   <SEG type="GetEStatementsCAMT" version="1" />
 </JOBdef>


 <!-- Geschaeftsvorfall: Uebersicht Kontoauszuege (Version 1-3) -->
